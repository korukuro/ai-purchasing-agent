# Google Gemini API key (free tier works) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id, or a comma-separated fallback chain. When the first model's free-tier DAILY
# quota runs out, the client switches to the next one. "npm run check-llm" lists the models your key can use.
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# Client-side rate limit so the free tier doesn't 429 (requests per minute).
LLM_RPM=5

# API server port (the Vite dev server proxies /api to it)
PORT=8787

# Agent loop budgets
AGENT_MAX_LLM_STEPS=30
AGENT_MAX_REPLANS=2
AGENT_MAX_GUARDRAIL_REJECTIONS=3
