# Google Gemini API key (free tier works) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model id. "gemini-flash-latest" always points at the current Flash model.
# Pin a specific one (e.g. gemini-2.5-flash) for reproducible evals.
GEMINI_MODEL=gemini-flash-latest

# Client-side rate limit so the free tier doesn't 429 (requests per minute).
LLM_RPM=10

# API server port (the Vite dev server proxies /api to it)
PORT=8787

# Agent loop budgets
AGENT_MAX_LLM_STEPS=30
AGENT_MAX_REPLANS=2
AGENT_MAX_GUARDRAIL_REJECTIONS=3
